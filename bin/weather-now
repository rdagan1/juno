#!/usr/bin/env node
// weather-now — current conditions as JSON, on any host.
//
//   weather-now [--json]
//
// Prints {"currentWeather": {temperature, conditionCode, precipitationChance, uvIndex}}
// — the shape `apple-weather --findme --json` emits, so callers (hum weather
// harvester, `merlin context`) don't care which backend answered.
//
// Backends, in order:
//   1. bin/apple-weather (macOS WeatherKit helper, BYO) if it exists.
//   2. Open-Meteo (free, no key) at MERLIN_WEATHER_LAT / MERLIN_WEATHER_LON from .env.
// Exits 1 with a message on stderr when neither is available.

import fs from "node:fs";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { createRequire } from "node:module";

const require = createRequire(import.meta.url);
const __dir = path.dirname(fileURLToPath(import.meta.url));
const MERLIN_HOME = process.env.MERLIN_HOME || path.resolve(__dir, "..");
require("../lib/load-env.js").loadEnv(path.join(MERLIN_HOME, ".env"));

function die(msg) { process.stderr.write(`weather-now: ${msg}\n`); process.exit(1); }

const apple = path.join(__dir, "apple-weather");
if (fs.existsSync(apple)) {
  const r = spawnSync(apple, ["--findme", "--json"], { encoding: "utf8", timeout: 10000 });
  if (r.status === 0 && r.stdout.trim()) { process.stdout.write(r.stdout); process.exit(0); }
}

const lat = process.env.MERLIN_WEATHER_LAT, lon = process.env.MERLIN_WEATHER_LON;
if (!lat || !lon) die("no apple-weather binary and MERLIN_WEATHER_LAT / MERLIN_WEATHER_LON unset in .env");

// WMO weather codes → WeatherKit-style condition names (the vocabulary the
// harvester's mislabel guard and the ranker already use).
function condition(code) {
  if (code === 0) return "Clear";
  if (code === 1) return "MostlyClear";
  if (code === 2) return "PartlyCloudy";
  if (code === 3) return "Cloudy";
  if (code === 45 || code === 48) return "Foggy";
  if (code >= 51 && code <= 57) return "Drizzle";
  if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return code === 65 || code === 82 ? "HeavyRain" : "Rain";
  if ((code >= 71 && code <= 77) || code === 85 || code === 86) return "Snow";
  if (code >= 95) return "Thunderstorms";
  return "Unknown";
}

// OPEN_METEO_URL: point at a self-hosted Open-Meteo instance (or a test stub).
const url = new URL(process.env.OPEN_METEO_URL || "https://api.open-meteo.com/v1/forecast");
url.search = new URLSearchParams({
  latitude: lat, longitude: lon,
  current: "temperature_2m,weather_code",
  hourly: "precipitation_probability,uv_index",
  forecast_hours: "1",
  temperature_unit: "fahrenheit",
  timezone: "auto",
}).toString();

try {
  const res = await fetch(url, { signal: AbortSignal.timeout(10000) });
  if (!res.ok) die(`open-meteo HTTP ${res.status}`);
  const d = await res.json();
  const out = {
    currentWeather: {
      temperature: d.current?.temperature_2m,
      conditionCode: condition(d.current?.weather_code),
      precipitationChance: (d.hourly?.precipitation_probability?.[0] ?? 0) / 100,
      uvIndex: d.hourly?.uv_index?.[0] ?? 0,
    },
    source: "open-meteo",
  };
  process.stdout.write(JSON.stringify(out) + "\n");
} catch (e) {
  die(`open-meteo fetch failed: ${e.message}`);
}
